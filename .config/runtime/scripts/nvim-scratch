#!/usr/bin/env sh

# nvim-scratch — one persistent nvim server per named scratchpad, driven as
# a tmux-independent service: attach/open/eval/status/stop/doctor all work
# against plain sockets, no tmux required. tmux *presentation* (the
# floating pane / popup toggle) is a separate concern owned by the
# dedicated helper at $XDG_CONFIG_HOME/tmux/scripts/nvim-scratch-toggle;
# `toggle`/`close` here are thin compatibility forwards to it.
#
# Usage: nvim-scratch [SUBCOMMAND] [NAME]
#   attach   (default)  ensure server, attach a UI in the current terminal
#                        (blocking)
#   open                 ensure server, open FILE(s) in it, do not attach
#   eval                  evaluate a Vimscript EXPR against a live server
#   toggle                 forwards to the tmux helper (floating pane/popup)
#   close                   forwards to the tmux helper; no-op otherwise
#   stop                     quit the server for NAME, remove its socket
#   status                    one line per live instance
#   doctor                     environment + per-instance diagnostics
# NAME defaults to "scratch". Run with -h/--help for the full synopsis,
# including `open`/`eval`'s own argument forms.
#
# The server is persistent, the UI is disposable. `nvim-scratch attach`
# opens an ordinary `--remote-ui` client against a `--headless --listen`
# server that keeps running long after that client goes away: closing the
# pane, killing the terminal, or `:detach` (a builtin Ex command) all just
# drop the UI. `:q` inside the client is different — it closes the last
# window of the *server's* Vim instance, which quits the server, same as
# `:q` would in any other nvim. There is no visual difference between a UI
# that is about to detach and one about to kill the server; the command you
# type is what decides it. `:detach` (or just closing the pane) to leave the
# scratchpad running, `:q` / `:qa` to actually kill it.
#
# The socket prefers $XDG_RUNTIME_DIR (mode 0700): a `--listen` socket is
# an unauthenticated msgpack-RPC endpoint exposing `nvim_exec_lua`, i.e.
# arbitrary code execution for whoever can connect to it, and
# $XDG_RUNTIME_DIR is a per-user 0700 directory that only this user's own
# processes can even see. When it is unset, the fallback is a dedicated
# leaf under $TMPDIR (default /tmp) — /tmp itself is world-traversable, so
# that leaf is never trusted blindly: a symlink, an owner mismatch, or a
# mode looser than 0700 fails the whole invocation rather than being
# silently "fixed" past (see ns_prepare_sock_dir), for either location.
#
# Env overrides (defaulted below; plugins/nvim-scratch.sh sets none of
# these — the server outlives the shell that spawned it, so a later shell's
# defaults would just be a second, driftable copy of the ones below):
#   NVIM_SCRATCH_NVIM        nvim binary                   (default: nvim)
#   NVIM_SCRATCH_NVIM_ARGS   extra args, word-split          (default: "")
#   NVIM_SCRATCH_FILE        explicit state-file override for NAME
#   NVIM_SCRATCH_STATE_DIR   explicit state-dir override
#
# NVIM_SCRATCH_SURFACE and NVIM_SCRATCH_SIZE (tmux float/popup kind and
# dimensions) are owned by the tmux helper, not this script.

set -eu

case $0 in
    /*) SELF=$0 ;;
    *)  SELF=$(cd "${0%/*}" 2>/dev/null && pwd)/${0##*/} ;;
esac

. "${SELF%/*}/../core/lib.sh"

: "${NVIM_SCRATCH_NVIM:=nvim}"
: "${NVIM_SCRATCH_NVIM_ARGS:=}"

ns_has_timeout=0
has_cmd timeout && ns_has_timeout=1
ns_has_setsid=0
has_cmd setsid && ns_has_setsid=1

ns_usage() {
    cat <<'EOF'
usage: nvim-scratch [SUBCOMMAND] [NAME]
       nvim-scratch open [--name NAME] FILE...
       nvim-scratch open NAME -- FILE...
       nvim-scratch eval [NAME] EXPR

  attach   (default)  ensure server, attach a UI in the current terminal
                       (blocking)
  open                ensure server, open FILE(s) in it; does not attach
  eval                evaluate a Vimscript EXPR against an already-running
                       server and print the result; never spawns one
  toggle              forwards to the tmux helper (nvim-scratch-toggle)
  close               forwards to the tmux helper; no-op if unavailable
  stop                quit the server for NAME, remove its socket
  status              one line per live instance
  doctor              environment + per-instance diagnostics

NAME defaults to "scratch". `eval EXPR` targets the default scratch;
`eval NAME EXPR` targets NAME.
EOF
}

# --------------------------------------------------------------------------
# Paths
# --------------------------------------------------------------------------

ns_sock_dir_compute() {
    if [ -n "${XDG_RUNTIME_DIR:-}" ]; then
        ns_sock_dir="$XDG_RUNTIME_DIR/nvim-scratch"
    else
        ns_sock_dir="${TMPDIR:-/tmp}/nvim-scratch-$(id -u)"
    fi
}

ns_default_state_dir() {
    printf '%s\n' "${NVIM_SCRATCH_STATE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/nvim-scratch}"
}

ns_state_file_for() {
    # $1 = NAME -> the default state-file path, ignoring NVIM_SCRATCH_FILE
    # (that override only makes sense for the single instance an invocation
    # is actually acting on, not for every name a listing happens to find).
    printf '%s/%s.md\n' "$(ns_default_state_dir)" "$1"
}

ns_stat_owner() {
    # $1 = path -> owning uid, or "" if it cannot be stat'd.
    stat -c '%u' "$1" 2>/dev/null || stat -f '%u' "$1" 2>/dev/null || printf ''
}

ns_stat_mode() {
    # $1 = path -> octal mode, or "" if it cannot be stat'd.
    stat -c '%a' "$1" 2>/dev/null || stat -f '%Lp' "$1" 2>/dev/null || printf ''
}

ns_sock_dir_state() {
    # $1 = the private socket directory. Sets ns_secure_reason when it
    # returns something other than 0. This directory holds unauthenticated
    # msgpack-RPC sockets (arbitrary code execution for whoever can
    # connect), so an existing entry is never repaired into trust: a
    # symlink, a mode looser than 0700, or an owner other than us fails
    # closed instead of being "fixed" past. Applies equally to the
    # $TMPDIR fallback used when XDG_RUNTIME_DIR is unset, where the risk
    # of a pre-planted directory from another user is highest.
    #   0 = present and trustworthy — safe to create sockets in, traverse,
    #       or probe.
    #   1 = present but not trustworthy — never traversed or probed.
    #   2 = absent — nothing to check yet, not an error by itself.
    ns_dir=$1

    if [ ! -e "$ns_dir" ] && [ ! -L "$ns_dir" ]; then
        return 2
    fi
    if [ -L "$ns_dir" ]; then
        ns_secure_reason="refusing symlinked socket dir: $ns_dir"
        return 1
    fi
    if [ ! -d "$ns_dir" ]; then
        ns_secure_reason="socket dir path exists but is not a directory: $ns_dir"
        return 1
    fi

    ns_owner=$(ns_stat_owner "$ns_dir")
    if [ -z "$ns_owner" ] || [ "$ns_owner" != "$(id -u)" ]; then
        ns_secure_reason="socket dir not owned by uid $(id -u): $ns_dir (owner: ${ns_owner:-unknown})"
        return 1
    fi

    ns_mode=$(ns_stat_mode "$ns_dir")
    if [ "$ns_mode" != "700" ]; then
        ns_secure_reason="socket dir mode is ${ns_mode:-unknown}, want 700: $ns_dir"
        return 1
    fi

    return 0
}

ns_prepare_sock_dir() {
    # $1 = the private socket directory, created on demand. A brand-new
    # directory is always made with mode 700 directly (mkdir -m, not a
    # post-hoc chmod), so it never needs repairing. An existing directory
    # is checked, never repaired: see ns_sock_dir_state.
    ns_dir=$1

    if [ ! -e "$ns_dir" ] && [ ! -L "$ns_dir" ]; then
        # shellcheck disable=SC2174 # only the leaf dir is new; parents (XDG_RUNTIME_DIR / TMPDIR) already exist
        mkdir -m 700 -p "$ns_dir" 2>/dev/null || true
    fi

    ns_sock_dir_state "$ns_dir" && ns_dirstate=0 || ns_dirstate=$?
    case "$ns_dirstate" in
        0) return 0 ;;
        2)
            error "nvim-scratch: cannot create socket dir: $ns_dir"
            exit 1
            ;;
        *)
            error "nvim-scratch: $ns_secure_reason"
            exit 1
            ;;
    esac
}

# Resolves every path for NAME into globals (ns_state_dir, ns_file,
# ns_sock_dir, ns_sock, ns_lock, ns_log, ns_cache_dir, ns_shada), creating
# and permission-checking the directories along the way.
ns_paths() {
    ns_name=$1

    ns_state_dir=$(ns_default_state_dir)
    ns_file="${NVIM_SCRATCH_FILE:-$ns_state_dir/$ns_name.md}"
    ns_file_dir=${ns_file%/*}

    ns_sock_dir_compute
    ns_sock="$ns_sock_dir/$ns_name.sock"
    ns_lock="$ns_sock_dir/$ns_name.lock"
    ns_log="$ns_sock_dir/$ns_name.log"

    ns_cache_dir="${XDG_CACHE_HOME:-$HOME/.cache}/nvim-scratch/$ns_name"
    ns_shada="$ns_cache_dir/main.shada"

    # Unix domain socket paths are capped near 104 bytes (sun_path) on many
    # platforms; a silently truncated path could hand two different names
    # the same clipped socket, so refuse loudly well short of that instead.
    if [ "${#ns_sock}" -gt 100 ]; then
        error "nvim-scratch: socket path too long (${#ns_sock} chars, limit 100): $ns_sock"
        exit 1
    fi

    mkdir -p "$ns_state_dir" "$ns_file_dir" "$ns_cache_dir" 2>/dev/null || true
    [ -d "$ns_state_dir" ] && [ -d "$ns_file_dir" ] && [ -d "$ns_cache_dir" ] || {
        error "nvim-scratch: cannot create state/cache directories under $ns_state_dir"
        exit 1
    }

    ns_prepare_sock_dir "$ns_sock_dir"
}

ns_dir_age() {
    # $1 = directory -> seconds since mtime, or a large number when it
    # cannot be stat'd (already gone, or no usable stat flavor).
    ns_mtime=$(stat -c '%Y' "$1" 2>/dev/null || stat -f '%m' "$1" 2>/dev/null) || {
        printf '%s\n' 999999
        return 0
    }
    printf '%s\n' $(( $(date +%s) - ns_mtime ))
}

# --------------------------------------------------------------------------
# Liveness
# --------------------------------------------------------------------------

ns_probe_live() {
    # $1 = socket path. A socket file with no listener refuses the
    # connection immediately, so the unwrapped fallback is not a real hang
    # risk — `timeout` is a courtesy for anything stranger.
    if [ "$ns_has_timeout" -eq 1 ]; then
        timeout 2 "$NVIM_SCRATCH_NVIM" --server "$1" --remote-expr 1 >/dev/null 2>&1
    else
        "$NVIM_SCRATCH_NVIM" --server "$1" --remote-expr 1 >/dev/null 2>&1
    fi
}

ns_stale() {
    # $1 = socket path -> true (and removes the file) when a socket file
    # exists but nothing answers; false when it's simply absent, or live.
    [ -S "$1" ] || return 1
    if ns_probe_live "$1"; then
        return 1
    fi
    rm -f "$1" 2>/dev/null || true
    return 0
}

# --------------------------------------------------------------------------
# Ownership guards
# --------------------------------------------------------------------------

ns_check_sock_owner() {
    # $1 = the expected socket path for a NAME. The containing directory
    # is already trusted (0700, owned by us) by the time this runs, but
    # fail closed anyway before ever probing or adopting (spawning over,
    # connecting to) a path that turns out not to be ours: never trust an
    # existing entry just because its directory is trustworthy.
    if [ -L "$1" ]; then
        error "nvim-scratch: refusing symlinked socket path: $1"
        exit 1
    fi
    [ -e "$1" ] || return 0
    ns_owner=$(ns_stat_owner "$1")
    if [ -z "$ns_owner" ] || [ "$ns_owner" != "$(id -u)" ]; then
        error "nvim-scratch: refusing socket not owned by uid $(id -u): $1 (owner: ${ns_owner:-unknown})"
        exit 1
    fi
}

ns_check_log_path() {
    # $1 = the spawn log path, about to be truncated with `: >`. Fail
    # closed first: an existing entry must already be an ordinary file we
    # own, never a symlink planted to redirect that truncation elsewhere.
    if [ -L "$1" ]; then
        error "nvim-scratch: refusing symlinked log path: $1"
        exit 1
    fi
    [ -e "$1" ] || return 0
    if [ ! -f "$1" ]; then
        error "nvim-scratch: refusing non-regular log path: $1"
        exit 1
    fi
    ns_owner=$(ns_stat_owner "$1")
    if [ -z "$ns_owner" ] || [ "$ns_owner" != "$(id -u)" ]; then
        error "nvim-scratch: refusing log path not owned by uid $(id -u): $1 (owner: ${ns_owner:-unknown})"
        exit 1
    fi
}

# --------------------------------------------------------------------------
# Spawn (idempotent, race-safe)
# --------------------------------------------------------------------------

ns_spawn() {
    # $1 = NAME. Assumes the caller already holds ns_lock and has resolved
    # ns_sock / ns_shada / ns_file / ns_state_dir / ns_log via ns_paths.
    ns_check_log_path "$ns_log"
    : > "$ns_log" 2>/dev/null || true

    # `-u TMUX -u TMUX_PANE`: the server is spawned once and its environment
    # is frozen forever after — inheriting a pane id means every pane-aware
    # plugin running inside it targets a pane that died days ago.
    # `-i "$ns_shada"`: a dedicated shada file so a long-lived scratchpad
    # never clobbers the marks/registers of ordinary nvim sessions.
    # `--cmd`: tags the instance for the user's config (g:scratchpad) and,
    # as a side effect, suppresses persistence.nvim's "Restore session?"
    # prompt (its launched_bare() guard checks for --cmd).
    # Trailing "$ns_file": a bare headless launch lands on the
    # non-modifiable snacks_dashboard buffer; a real file avoids that.
    if [ "$ns_has_setsid" -eq 1 ]; then
        # Redirects wrap the whole subshell (not just the final command),
        # so the forked process has fds 0/1/2 pointed at /dev/null and
        # ns_log from the instant it exists — no window where it still
        # holds this script's own stdin/stdout/stderr (e.g. a caller's
        # capture pipe) before exec takes over. `exec` into setsid means
        # no shell is left in the chain once nvim is running: the
        # backgrounded subshell process becomes setsid, which becomes
        # nvim, with nothing left behind to keep those fds — or the
        # process itself — alive once the caller has moved on.
        # shellcheck disable=SC2086 # word-splitting NVIM_SCRATCH_NVIM_ARGS is the feature
        ( cd "$ns_state_dir" && exec setsid env -u TMUX -u TMUX_PANE \
            "$NVIM_SCRATCH_NVIM" --headless --listen "$ns_sock" \
            -i "$ns_shada" --cmd "let g:scratchpad='$1'" \
            $NVIM_SCRATCH_NVIM_ARGS -- "$ns_file" \
        ) </dev/null >"$ns_log" 2>&1 &
    else
        # No setsid: same shape, minus the new-session step. The
        # backgrounded subshell still exits (via exec) the instant nvim
        # replaces it, so it never lingers as a shell process, and nvim
        # itself is reparented to init like any other orphaned background
        # job once this script exits.
        # shellcheck disable=SC2086 # word-splitting NVIM_SCRATCH_NVIM_ARGS is the feature
        ( cd "$ns_state_dir" && exec env -u TMUX -u TMUX_PANE \
            "$NVIM_SCRATCH_NVIM" --headless --listen "$ns_sock" \
            -i "$ns_shada" --cmd "let g:scratchpad='$1'" \
            $NVIM_SCRATCH_NVIM_ARGS -- "$ns_file" \
        ) </dev/null >"$ns_log" 2>&1 &
    fi

    ns_i=0
    while [ "$ns_i" -lt 50 ]; do
        if ns_probe_live "$ns_sock"; then
            return 0
        fi
        sleep 0.1
        ns_i=$((ns_i + 1))
    done

    error "nvim-scratch: server for '$1' did not become ready within 5s"
    if [ -r "$ns_log" ]; then
        error "--- tail of $ns_log ---"
        tail -n 20 "$ns_log" >&2 2>/dev/null || true
    fi
    return 1
}

# --------------------------------------------------------------------------
# Lifecycle lock (shared by ensure/start and stop)
# --------------------------------------------------------------------------

ns_lock_acquired=0

ns_lock_release() {
    # Removes ns_lock only when *this* invocation is the one that created
    # it via ns_lock_acquire — never a lock some concurrent starter or
    # stopper still owns. Safe to call as a plain function or as the
    # EXIT/INT/TERM trap handler; idempotent either way.
    if [ "$ns_lock_acquired" -eq 1 ]; then
        rm -rf "$ns_lock" 2>/dev/null || true
        ns_lock_acquired=0
    fi
    trap - EXIT INT TERM
}

ns_lock_acquire() {
    # $1 = NAME, for context only. Serializes every liveness decision
    # (ensure/start and stop alike) on the one per-name mkdir lock: no
    # caller may probe staleness/liveness, spawn, or shut down until it
    # holds ns_lock. On success, installs a trap so a crash or signal
    # between acquire and release still cleans up — but only the lock
    # this invocation created.
    ns_lock_acquired=0

    if mkdir "$ns_lock" 2>/dev/null; then
        ns_lock_acquired=1
        trap 'ns_lock_release' EXIT INT TERM
        return 0
    fi

    # Someone else holds it (another ensure, or a stop). Wait up to 5s for
    # them to release it, re-attempting the instant it looks gone.
    ns_i=0
    while [ "$ns_i" -lt 50 ]; do
        if [ ! -d "$ns_lock" ] && mkdir "$ns_lock" 2>/dev/null; then
            ns_lock_acquired=1
            trap 'ns_lock_release' EXIT INT TERM
            return 0
        fi
        sleep 0.1
        ns_i=$((ns_i + 1))
    done

    # Still held after 5s: only recover it once it is old enough to
    # plausibly be abandoned by a crashed invocation, never a live one.
    if [ -d "$ns_lock" ] && [ "$(ns_dir_age "$ns_lock")" -ge 60 ]; then
        rm -rf "$ns_lock" 2>/dev/null || true
        if mkdir "$ns_lock" 2>/dev/null; then
            ns_lock_acquired=1
            trap 'ns_lock_release' EXIT INT TERM
            return 0
        fi
    fi

    return 1
}

ns_ensure_server() {
    ns_name=$1
    ns_check_sock_owner "$ns_sock"

    if ! ns_lock_acquire "$ns_name"; then
        error "nvim-scratch: '$ns_name' did not come up (lock held by another process: $ns_lock)"
        return 1
    fi

    # Holding the lock: the pre-acquire ownership check above is stale
    # after any wait, so re-check before making the liveness decision,
    # which — like every decision from here on — is entirely ours to
    # make; never adopt a socket without holding the lock, since a
    # concurrent stop could be tearing it down at the same moment.
    ns_check_sock_owner "$ns_sock"
    if [ -S "$ns_sock" ] && ns_probe_live "$ns_sock"; then
        ns_lock_release
        return 0
    fi
    ns_stale "$ns_sock" || true
    ns_spawn "$ns_name"
    ns_rc=$?
    ns_lock_release
    return "$ns_rc"
}

# --------------------------------------------------------------------------
# attach
# --------------------------------------------------------------------------

ns_cmd_attach() {
    ns_paths "$1"
    ns_ensure_server "$1"
    # Deliberately not `exec`'d: with exec, this pane's foreground command
    # becomes `nvim --server ...`, which tmux-resurrect (configured with
    # @resurrect-strategy-nvim 'session') would try to restore after a
    # reboot as a UI client pointed at a socket that no longer exists.
    # Staying as `nvim-scratch` — a program resurrect does not try to
    # special-case — means a restored pane just re-runs this script, which
    # transparently re-attaches (or respawns) instead.
    "$NVIM_SCRATCH_NVIM" --server "$ns_sock" --remote-ui
}

# --------------------------------------------------------------------------
# open
# --------------------------------------------------------------------------

ns_cmd_open() {
    case "${1:-}" in
        -h | --help)
            ns_usage
            exit 0
            ;;
    esac

    ns_open_name=scratch
    if [ "${1:-}" = "--name" ]; then
        [ $# -ge 2 ] || {
            error "nvim-scratch: --name requires a value"
            exit 2
        }
        ns_open_name=$2
        shift 2
    elif [ $# -ge 2 ] && [ "$2" = "--" ]; then
        ns_open_name=$1
        shift 2
    fi

    ns_validate_name "$ns_open_name"

    [ $# -ge 1 ] || {
        error "nvim-scratch: open requires at least one FILE"
        ns_usage >&2
        exit 2
    }

    # Each FILE becomes an absolute path from the *caller's* cwd before
    # nvim ever sees it: the server's own cwd is ns_state_dir (see
    # ns_spawn), so a relative path handed straight to --remote would
    # resolve against the wrong directory. Rebuilding $@ in place (instead
    # of joining into one string) keeps embedded spaces intact — the `for`
    # loop already snapshotted the original list, so reassigning $@ inside
    # it via `set --` is safe.
    ns_open_first=1
    for ns_f in "$@"; do
        case "$ns_f" in
            /*) : ;;
            *) ns_f="$PWD/$ns_f" ;;
        esac
        if [ "$ns_open_first" -eq 1 ]; then
            set -- "$ns_f"
            ns_open_first=0
        else
            set -- "$@" "$ns_f"
        fi
    done

    ns_paths "$ns_open_name"
    ns_ensure_server "$ns_open_name"

    # One --remote call so nvim's own arglist handling opens every file,
    # rather than N separate client invocations.
    "$NVIM_SCRATCH_NVIM" --server "$ns_sock" --remote "$@"
}

# --------------------------------------------------------------------------
# eval
# --------------------------------------------------------------------------

ns_cmd_eval() {
    case "${1:-}" in
        -h | --help)
            ns_usage
            exit 0
            ;;
    esac

    case $# in
        1)
            ns_eval_name=scratch
            ns_eval_expr=$1
            ;;
        2)
            ns_eval_name=$1
            ns_eval_expr=$2
            ;;
        *)
            error "nvim-scratch: eval takes 'EXPR' or 'NAME EXPR'"
            ns_usage >&2
            exit 2
            ;;
    esac

    ns_validate_name "$ns_eval_name"
    ns_paths "$ns_eval_name"
    ns_check_sock_owner "$ns_sock"

    if ! { [ -S "$ns_sock" ] && ns_probe_live "$ns_sock"; }; then
        error "nvim-scratch: '$ns_eval_name' is not running — eval never spawns a server; use 'open' or 'attach' first"
        exit 1
    fi

    # $ns_eval_expr reaches --remote-expr as a single argv value, never
    # through a shell `eval`: whatever it contains is Vimscript for nvim to
    # evaluate, not shell syntax for this script to interpret.
    "$NVIM_SCRATCH_NVIM" --server "$ns_sock" --remote-expr "$ns_eval_expr"
}

# --------------------------------------------------------------------------
# toggle / close — compatibility forwards to the tmux helper
# --------------------------------------------------------------------------

ns_helper_path() {
    printf '%s\n' "${XDG_CONFIG_HOME:-$HOME/.config}/tmux/scripts/nvim-scratch-toggle"
}

ns_cmd_toggle() {
    ns_helper=$(ns_helper_path)
    if [ ! -x "$ns_helper" ]; then
        error "nvim-scratch: toggle needs the tmux helper: $ns_helper"
        exit 2
    fi
    "$ns_helper" toggle "$1"
}

ns_cmd_close() {
    # Never an error when the helper is unavailable — this runs
    # unconditionally from tmux's client-detached hook, which must not
    # fail just because there is no surface to close.
    ns_helper=$(ns_helper_path)
    [ -x "$ns_helper" ] || return 0
    "$ns_helper" close "$1"
}

# --------------------------------------------------------------------------
# stop
# --------------------------------------------------------------------------

ns_cmd_stop() {
    ns_paths "$1"
    ns_check_sock_owner "$ns_sock"
    # Presentation is not this command's concern: killing the server makes
    # any attached remote UI exit on its own, and the tmux helper's pane
    # closes naturally as a result — no need to call ns_cmd_close here.

    if ! ns_lock_acquire "$1"; then
        error "nvim-scratch: '$1' is locked by another invocation, not stopping: $ns_lock"
        return 1
    fi

    # Holding the lock: the pre-acquire ownership check above is stale
    # after any wait, so re-check before making any liveness decision.
    ns_check_sock_owner "$ns_sock"

    ns_rc=0
    if [ -S "$ns_sock" ] && ns_probe_live "$ns_sock"; then
        # The server dies mid-call, so its response is garbage (or none) —
        # that is expected, not an error.
        "$NVIM_SCRATCH_NVIM" --server "$ns_sock" --remote-expr 'execute("qa!")' >/dev/null 2>&1 || true
        ns_i=0
        while [ "$ns_i" -lt 20 ]; do
            ns_probe_live "$ns_sock" || break
            sleep 0.1
            ns_i=$((ns_i + 1))
        done
        if ns_probe_live "$ns_sock"; then
            error "nvim-scratch: '$1' did not stop within 2s — its socket is still live, leaving it in place: $ns_sock"
            ns_rc=1
        else
            rm -f "$ns_sock" 2>/dev/null || true
            success "nvim-scratch: stopped '$1'"
        fi
    else
        rm -f "$ns_sock" 2>/dev/null || true
        info "nvim-scratch: '$1' was not running"
    fi

    ns_lock_release
    return "$ns_rc"
}

# --------------------------------------------------------------------------
# status
# --------------------------------------------------------------------------

ns_cmd_status() {
    ns_sock_dir_compute
    ns_sock_dir_state "$ns_sock_dir" && ns_dirstate=0 || ns_dirstate=$?
    case "$ns_dirstate" in
        2) return 0 ;;
        1)
            error "nvim-scratch: $ns_secure_reason"
            return 1
            ;;
    esac
    for ns_f in "$ns_sock_dir"/*.sock; do
        [ -e "$ns_f" ] || continue
        ns_n=${ns_f##*/}
        ns_n=${ns_n%.sock}
        ns_stfile=$(ns_state_file_for "$ns_n")
        if ns_probe_live "$ns_f"; then
            printf '%-12s live  uis=%-3s pid=%-8s %s\n' "$ns_n" \
                "$("$NVIM_SCRATCH_NVIM" --server "$ns_f" --remote-expr 'len(nvim_list_uis())' 2>/dev/null || printf '?')" \
                "$("$NVIM_SCRATCH_NVIM" --server "$ns_f" --remote-expr 'getpid()' 2>/dev/null || printf '?')" \
                "$ns_stfile"
        else
            printf '%-12s stale uis=-   pid=-        %s\n' "$ns_n" "$ns_stfile"
        fi
    done
}

# --------------------------------------------------------------------------
# doctor
# --------------------------------------------------------------------------

ns_cmd_doctor() {
    ns_fault=0

    printf 'nvim:\n'
    if ns_bin=$(command -v "$NVIM_SCRATCH_NVIM" 2>/dev/null); then
        printf '  binary   %s\n' "$ns_bin"
        printf '  version  %s\n' "$("$NVIM_SCRATCH_NVIM" --version 2>/dev/null | head -n 1 || printf unknown)"
    else
        printf '  binary   NOT FOUND (NVIM_SCRATCH_NVIM=%s)\n' "$NVIM_SCRATCH_NVIM"
        ns_fault=1
    fi

    printf '\ntmux:\n'
    if has_cmd tmux; then
        printf '  version  %s\n' "$(tmux -V 2>/dev/null || printf unknown)"
    else
        printf '  not installed (toggle/close are unavailable; attach/open/eval/stop/status/doctor still work)\n'
    fi

    printf '\ntmux helper:\n'
    ns_helper=$(ns_helper_path)
    if [ -x "$ns_helper" ]; then
        printf '  path  %s\n' "$ns_helper"
        ns_helper_out=$("$ns_helper" doctor 2>&1) && ns_helper_rc=0 || ns_helper_rc=$?
        printf '%s\n' "$ns_helper_out" | sed 's/^/  /'
        [ "$ns_helper_rc" -eq 0 ] || ns_fault=1
    else
        printf '  not found or not executable: %s\n' "$ns_helper"
        printf '  toggle/close are unavailable; attach/open/eval/stop/status/doctor still work\n'
    fi

    printf '\nhelpers:\n'
    if [ "$ns_has_timeout" -eq 1 ]; then
        printf '  timeout  yes\n'
    else
        printf '  timeout  no — liveness probes run unwrapped (a dead socket file refuses instantly, so this is not a real hang risk)\n'
    fi
    if [ "$ns_has_setsid" -eq 1 ]; then
        printf '  setsid   yes\n'
    else
        printf '  setsid   no — spawn falls back to a redirected background subshell that execs nvim directly (no new session)\n'
    fi

    ns_sock_dir_compute
    printf '\nsocket dir: %s\n' "$ns_sock_dir"
    ns_sock_dir_state "$ns_sock_dir" && ns_dirstate=0 || ns_dirstate=$?
    case "$ns_dirstate" in
        2)
            printf '  does not exist yet (created on first spawn)\n'
            ;;
        0)
            printf '  owner uid %s (ok)\n' "$(id -u)"
            printf '  mode 700 (ok)\n'
            ;;
        *)
            printf '  INSECURE — %s\n' "$ns_secure_reason"
            printf '  refusing to traverse or probe sockets in this directory\n'
            ns_fault=1
            ;;
    esac

    ns_sdir=$(ns_default_state_dir)
    ns_cdir="${XDG_CACHE_HOME:-$HOME/.cache}/nvim-scratch"
    printf '\nstate dir: %s\n' "$ns_sdir"
    if mkdir -p "$ns_sdir" 2>/dev/null && [ -w "$ns_sdir" ]; then
        printf '  writable\n'
    else
        printf '  NOT writable\n'
        ns_fault=1
    fi
    printf 'cache dir: %s\n' "$ns_cdir"
    if mkdir -p "$ns_cdir" 2>/dev/null && [ -w "$ns_cdir" ]; then
        printf '  writable\n'
    else
        printf '  NOT writable\n'
        ns_fault=1
    fi

    printf '\npath:\n'
    ns_self_dir=${SELF%/*}
    case ":$PATH:" in
        *":$ns_self_dir:"*)
            printf '  %s is on PATH (ok)\n' "$ns_self_dir"
            ;;
        *)
            printf '  %s is NOT on PATH\n' "$ns_self_dir"
            printf '  a tmux keybinding invoking "nvim-scratch" by name will fail; add it to PATH, then restart the tmux server (not just the client) so it inherits the change\n'
            ns_fault=1
            ;;
    esac

    printf '\ninstances:\n'
    ns_any=0
    case "$ns_dirstate" in
        0)
            for ns_f in "$ns_sock_dir"/*.sock; do
                [ -e "$ns_f" ] || continue
                ns_any=1
                ns_n=${ns_f##*/}
                ns_n=${ns_n%.sock}
                if ns_probe_live "$ns_f"; then
                    ns_d=$("$NVIM_SCRATCH_NVIM" --server "$ns_f" --remote-expr 'exists(":detach")' 2>/dev/null || printf '?')
                    printf '  %-12s live, exists(":detach")=%s — ":q" quits this server, ":detach" (or just closing the pane) does not\n' "$ns_n" "$ns_d"
                else
                    printf '  %-12s stale socket\n' "$ns_n"
                fi
            done
            [ "$ns_any" -eq 1 ] || printf '  (none)\n'
            ;;
        2) printf '  (none)\n' ;;
        *) printf '  skipped — socket dir is insecure\n' ;;
    esac

    printf '\nstatus:\n'
    ns_cmd_status | sed 's/^/  /'

    return "$ns_fault"
}

# --------------------------------------------------------------------------
# Argument handling
# --------------------------------------------------------------------------

ns_known_subcommand() {
    case "$1" in
        attach | toggle | close | stop | status | doctor) return 0 ;;
        *) return 1 ;;
    esac
}

ns_validate_name() {
    case "$1" in
        '')
            error "nvim-scratch: NAME must not be empty"
            exit 2
            ;;
        . | ..)
            error "nvim-scratch: NAME '$1' must not be '.' or '..'"
            exit 2
            ;;
        *[!a-zA-Z0-9_.-]*)
            error "nvim-scratch: NAME '$1' must match [A-Za-z0-9_.-]+"
            exit 2
            ;;
    esac
}

# `open` and `eval` take shapes the generic [SUBCOMMAND] [NAME] loop below
# cannot express (a FILE... list; an EXPR that may itself contain spaces),
# so they are dispatched here, before that loop ever sees argv.
case "${1:-}" in
    open)
        shift
        ns_cmd_open "$@"
        exit $?
        ;;
    eval)
        shift
        ns_cmd_eval "$@"
        exit $?
        ;;
esac

ns_sub=""
ns_name=""
ns_end_opts=0

while [ $# -gt 0 ]; do
    case $1 in
        --)
            if [ "$ns_end_opts" -eq 0 ]; then
                ns_end_opts=1
                shift
                continue
            fi
            ;;
        -h | --help)
            if [ "$ns_end_opts" -eq 0 ]; then
                ns_usage
                exit 0
            fi
            ;;
    esac
    if [ -z "$ns_sub" ] && ns_known_subcommand "$1"; then
        ns_sub=$1
    elif [ -z "$ns_name" ]; then
        ns_name=$1
    else
        error "nvim-scratch: unexpected argument: $1"
        ns_usage >&2
        exit 2
    fi
    shift
done

ns_sub=${ns_sub:-attach}
ns_name=${ns_name:-scratch}

ns_validate_name "$ns_name"

case "$ns_sub" in
    attach) ns_cmd_attach "$ns_name" ;;
    toggle) ns_cmd_toggle "$ns_name" ;;
    close) ns_cmd_close "$ns_name" ;;
    stop) ns_cmd_stop "$ns_name" ;;
    status) ns_cmd_status ;;
    doctor) ns_cmd_doctor ;;
esac

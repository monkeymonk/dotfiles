[Unit]
Description=llama-swap local LLM router
After=network.target ollama.service

[Service]
Type=simple
Environment=LLAMA_MODELS_DIR=/data/models
Environment=LLAMA_SWAP_CONFIG=%h/.config/llama-swap/config.yaml
ExecStart=/sbin/llama-swap -config %h/.config/llama-swap/config.yaml -listen 127.0.0.1:11435 -watch-config
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target
